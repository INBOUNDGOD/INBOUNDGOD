<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/om_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/om_accent"
            android:padding="18dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/om_onaccent"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your phone as a PC microphone"
                android:textColor="@color/om_onaccent"
                android:alpha="0.85"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- card: connection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:layout_margin="16dp"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONNECTION"
                android:textColor="@color/om_accent"
                android:textStyle="bold"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:paddingBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This phone's address"
                android:textColor="@color/om_subink"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/addr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/om_ink"
                android:textSize="22sp"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <EditText
                android:id="@+id/pin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:hint="Optional PIN"
                android:textColorHint="@color/om_subink"
                android:textColor="@color/om_ink"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp">
                <Button
                    android:id="@+id/toggle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Start"
                    android:textColor="@color/om_onaccent"
                    android:backgroundTint="@color/om_accent" />
                <Button
                    android:id="@+id/mute"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Mute"
                    android:backgroundTint="@color/om_mute"
                    android:textColor="@color/om_onaccent" />
            </LinearLayout>
        </LinearLayout>

        <!-- card: controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTROLS"
                android:textColor="@color/om_accent"
                android:textStyle="bold"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/micLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:textColor="@color/om_ink"
                android:text="Mic volume: 100%" />
            <SeekBar
                android:id="@+id/micGain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="300"
                android:progress="100" />

            <TextView
                android:id="@+id/nsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:textColor="@color/om_ink"
                android:text="Noise suppression: off" />
            <SeekBar
                android:id="@+id/noise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Removes steady noise (fans, hiss). Keyboard-while-talking needs the PC's RNNoise engine."
                android:textColor="@color/om_subink"
                android:textSize="11sp"
                android:paddingTop="2dp" />

            <CheckBox
                android:id="@+id/releaseOnCall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:checked="true"
                android:textColor="@color/om_ink"
                android:text="Release mic to calls / other apps" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/om_subink"
            android:paddingBottom="20dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Tap Start, then connect from your PC." />
    </LinearLayout>
</ScrollView>
