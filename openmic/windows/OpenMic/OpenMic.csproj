<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OpenMic</AssemblyName>
    <RootNamespace>OpenMic</RootNamespace>
    <!-- Bump this for each release you publish; the installed app auto-updates
         to the newest release it finds. -->
    <Version>1.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Auto-update. Keep this on the same 1.2.x line as the `vpk` tool you pack
         with (dotnet tool update -g vpk), or packing warns about a mismatch. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
